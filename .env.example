# =============================================================================
# Property Geocoder Microservice - Environment Configuration
# =============================================================================
#
# Copy this file to .env and update with your production values.
# IMPORTANT: Never commit .env files with real credentials to version control.
#
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geocoder
DB_USER=geocoder
# Required - no default. Generate a strong password (e.g. `openssl rand -hex 24`)
DB_PASSWORD=

# Connection pool settings
MIN_DB_CONNECTIONS=5
MAX_DB_CONNECTIONS=20

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# Supports redis:// and TLS rediss:// URLs. Keep the password out of the URL
# and use REDIS_PASSWORD below instead.
REDIS_URL=redis://localhost:6379

# Redis AUTH password. Required by docker-compose.prod.yml (the redis service
# starts with --requirepass). Overrides any password embedded in REDIS_URL.
REDIS_PASSWORD=

# Cache TTL (time to live)
CACHE_TTL_SECONDS=86400              # 24 hours for successful lookups
NEGATIVE_CACHE_TTL_SECONDS=3600      # 1 hour for not-found results

# Startup retry settings
REDIS_STARTUP_RETRIES=5
REDIS_RETRY_DELAY=1.0

# -----------------------------------------------------------------------------
# Authentication Configuration
# -----------------------------------------------------------------------------
# Enable/disable API key requirement
API_KEY_REQUIRED=true

# Header name for API key
API_KEY_HEADER=X-API-Key

# Prefix for generated API keys
API_KEY_PREFIX=gc_

# Server-side secret mixed into API key hashes (HMAC-SHA256). Strongly
# recommended in production. Generate with: openssl rand -hex 32
# Existing plain-SHA256 keys keep working via a legacy lookup fallback.
API_KEY_PEPPER=

# Cache TTL for validated API keys (seconds)
API_KEY_CACHE_TTL=300

# Initial admin API key (created on first startup if set)
# INITIAL_ADMIN_KEY=your_initial_admin_key_here
# INITIAL_ADMIN_KEY_NAME=initial-admin
# INITIAL_ADMIN_KEY_OWNER=system

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------
# Enable/disable rate limiting
RATE_LIMIT_ENABLED=true

# Maximum requests per window
RATE_LIMIT_REQUESTS=100

# Window size in seconds
RATE_LIMIT_WINDOW=60

# Maximum burst requests
RATE_LIMIT_BURST=20

# Fail closed if rate limiter is unavailable (deny requests when Redis is down)
# RATE_LIMIT_FAIL_CLOSED=false

# Admin rate limiting (separate limits for admin endpoints)
# ADMIN_RATE_LIMIT_REQUESTS=30
# ADMIN_RATE_LIMIT_WINDOW=60

# -----------------------------------------------------------------------------
# IP Filtering Configuration
# -----------------------------------------------------------------------------
# Enable/disable IP whitelist filtering (per API key)
IP_FILTER_ENABLED=true

# Trusted reverse proxies (comma-separated IPs or CIDRs, e.g. 10.0.0.5,172.16.0.0/12).
# X-Forwarded-For / X-Real-IP headers are ONLY honored when the direct
# connection comes from one of these addresses. Leave empty (default) to
# ignore proxy headers entirely and use the socket peer address.
TRUSTED_PROXIES=

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# Enable security headers (X-Content-Type-Options, X-Frame-Options, etc.)
SECURE_HEADERS_ENABLED=true

# Maximum request body size in bytes (default: 10MB)
# MAX_BODY_SIZE=10485760

# CORS allowed origins (comma-separated). Wildcard '*' is a hard startup
# error when ENV=production - specify exact domains:
# https://yourdomain.com,https://api.yourdomain.com
ALLOWED_ORIGINS=

# Request ID header name
REQUEST_ID_HEADER=X-Request-ID

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Server port
PORT=3000
API_PORT=3000

# Environment (development/production)
ENV=production

# Batch geocoding concurrency limit
BATCH_CONCURRENCY_LIMIT=10

# Enable SQL query logging (development only)
LOG_SQL_QUERIES=false

# -----------------------------------------------------------------------------
# Production Deployment (Docker)
# -----------------------------------------------------------------------------
# Number of gunicorn workers (typically 2-4x CPU cores)
GUNICORN_WORKERS=4

# =============================================================================
# Example: Development Configuration
# =============================================================================
#
# For local development, you might use:
#
# DB_HOST=localhost
# REDIS_URL=redis://localhost:6379
# API_KEY_REQUIRED=false
# RATE_LIMIT_ENABLED=false
# ENV=development
# LOG_SQL_QUERIES=true
#
# =============================================================================
# Example: Production Configuration
# =============================================================================
#
# For production, ensure:
#
# - Strong DB_PASSWORD and REDIS_PASSWORD
# - API_KEY_REQUIRED=true
# - API_KEY_PEPPER set to a strong random secret
# - RATE_LIMIT_ENABLED=true
# - SECURE_HEADERS_ENABLED=true
# - Specific ALLOWED_ORIGINS (not *)
# - TRUSTED_PROXIES set to your reverse proxy IPs (if any)
# - ENV=production
# - LOG_SQL_QUERIES=false
#
# =============================================================================
